# Supabase project credentials — from Supabase Dashboard →
# Project Settings → API. Copy this file to .env.local for local dev, and
# set the same values in your host's Project Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key (Project Settings → API → service_role). Server-only —
# never expose this with a NEXT_PUBLIC_ prefix. Bypasses row-level security,
# used only by the admin dashboard's server-side routes to read registrations.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in for hackathon registration is configured in the Supabase
# dashboard itself (Authentication → Providers → Google), using an OAuth
# Client ID/Secret from Google Cloud Console. No app-side env var needed here.

# Shared password gating /admin (registrations dashboard + CSV export).
# Pick a real password before deploying — this is the only thing standing
# between the public internet and every registrant's name/email.
ADMIN_PASSWORD=
